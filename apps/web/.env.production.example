# Copy to .env.production and fill with your deployed Fly server URL,
# OR set these as Build environment variables in the Cloudflare Pages dashboard.
# Vite inlines them at BUILD time, so they must be present when `vite build` runs.

# Your Fly app's HTTPS URL (from `flyctl info` / Fly dashboard):
VITE_HTTP_URL=https://cashflow-game-server.fly.dev
# Same host, wss:// scheme, /ws path:
VITE_WS_URL=wss://cashflow-game-server.fly.dev/ws
